PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/online_quiz
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Quizly <no-reply@example.com>

# Optional: enables AI-generated quiz questions (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: Override default Gemini model for Chints AI Studio
GEMINI_MODEL=gemini-3.8-flash
